+    /** The browser's open tabs, in order; `active` is the one being shown and driven. */
+    async tabs(botId: string): Promise<{ index: number; url: string; title: string; active: boolean }[]> {
+      const current = await this.page(botId);
+      const pages = current.context().pages().filter((p) => !p.isClosed());
+      return Promise.all(pages.map(async (p, index) => ({
+        index, url: p.url(), title: await p.title().catch(() => ""), active: p === current,
