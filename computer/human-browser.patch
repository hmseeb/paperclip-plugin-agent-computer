--- /dev/null
+++ b/agent-computer/tests/share.test.ts
@@ -0,0 +1,55 @@
+import { describe, expect, test } from "bun:test";
+import { blockedPage, clampSize, compilePattern, cookieForHosts, hostsOf, pageAllowed } from "../src/share";
+
+describe("shared browser page policy", () => {
+  const allow = ["dcc.godaddy.com/control/*/dns", "sso.godaddy.com", "*.vercel.com/badaaas", "https://example.com/a?x=1"];
+  test("allowed pages, subpaths, any scheme, wildcard hosts", () => {
+    expect(pageAllowed(allow, "https://dcc.godaddy.com/control/badaaas.com/dns")).toBe(true);
+    expect(pageAllowed(allow, "https://dcc.godaddy.com/control/badaaas.com/dns/records?x=1")).toBe(true);
+    expect(pageAllowed(allow, "https://sso.godaddy.com/login?path=x")).toBe(true);
+    expect(pageAllowed(allow, "https://vercel.com/badaaas/project")).toBe(true);
+    expect(pageAllowed(allow, "https://app.vercel.com/badaaas")).toBe(true);
+    expect(pageAllowed(allow, "http://example.com/a/b")).toBe(true);
+  });
+  test("everything else is blocked", () => {
+    expect(pageAllowed(allow, "https://dcc.godaddy.com/control/badaaas.com/billing")).toBe(false);
+    expect(pageAllowed(allow, "https://account.godaddy.com/")).toBe(false);
+    expect(pageAllowed(allow, "https://vercel.com/someone-else")).toBe(false);
+    expect(pageAllowed(allow, "https://evilvercel.com/badaaas")).toBe(false);
+    expect(pageAllowed(allow, "https://sso.godaddy.com.evil.io/")).toBe(false);
+    expect(pageAllowed(allow, "https://example.com/ab")).toBe(false);
+    expect(pageAllowed(allow, "file:///etc/passwd")).toBe(false);
+    expect(pageAllowed([], "https://google.com")).toBe(false);
+  });
+  test("browser-made pages always open", () => {
+    expect(pageAllowed([], "about:blank")).toBe(true);
+    expect(pageAllowed([], "chrome-error://chromewebdata/")).toBe(true);
+  });
+  test("bad patterns are ignored", () => {
+    expect(compilePattern("")).toBeNull();
+    expect(compilePattern("exa mple.com")).toBeNull();
+    expect(pageAllowed(["(.*)"], "https://x.com")).toBe(false);
+  });
+  test("the blocked page names the url and lists allowed links, escaped", () => {
+    const html = blockedPage("https://x.com/<script>", ["sso.godaddy.com", "*.vercel.com/a"]);
+    expect(html).toContain('<a href="https://sso.godaddy.com">sso.godaddy.com</a>');
+    expect(html).toContain("<code>*.vercel.com/a</code>");
+    expect(html).not.toContain("<script>");
+  });
+});
+
+describe("shared browser size and sign-in copy", () => {
+  test("window sizes are kept in range", () => {
+    expect(clampSize(390, 700)).toEqual({ width: 800, height: 700 });
+    expect(clampSize(3000, 2000)).toEqual({ width: 1920, height: 1200 });
+    expect(clampSize("x", 1)).toBeNull();
+  });
+  test("hosts from addresses, and which cookies a copy takes", () => {
+    expect(hostsOf(["https://dcc.godaddy.com/control/*", "*.vercel.com", "sso.godaddy.com", "a*.x.com"])).toEqual(["dcc.godaddy.com", "vercel.com", "sso.godaddy.com"]);
+    expect(cookieForHosts(".godaddy.com", ["dcc.godaddy.com"])).toBe(true);
+    expect(cookieForHosts("dcc.godaddy.com", ["dcc.godaddy.com"])).toBe(true);
+    expect(cookieForHosts(".google.com", ["dcc.godaddy.com"])).toBe(false);
+    expect(cookieForHosts(".co.uk", ["shop.x.co.uk"])).toBe(false);
+    expect(cookieForHosts(".x.co.uk", ["shop.x.co.uk"])).toBe(true);
+  });
+});
