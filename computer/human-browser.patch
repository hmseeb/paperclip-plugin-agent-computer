--- /dev/null
+++ b/agent-computer/src/share.ts
@@ -0,0 +1,143 @@
+/**
+ * Shared browsers (Paperclip Agent computer plugin): a browser lent to someone outside through a link.
+ *
+ * Three controls, per Bot, all in memory (the plugin pushes them again whenever it uses a share):
+ *
+ * - Its pages (`PUT /url-policy`): the addresses the person may open. Only top-level navigations are
+ *   checked, in every tab and popup; the scripts, images and APIs those pages load are not, since a
+ *   site needs dozens of hosts it never shows. Anything else gets a page saying what is allowed.
+ * - Its size (`POST /viewport`): the person's window, so the live screen fills it and clicks map 1:1.
+ *   The screencast is started at the same size (index.ts), which is what keeps clicks in place.
+ * - One site's sign-in (`POST /cookies/import`): copied from another Bot's browser, so a person can
+ *   use an account without its password. Only cookies for the hosts named.
+ */
+import type { BrowserContext, Route } from "playwright";
+
+export type Size = { width: number; height: number };
+export const DEFAULT_SIZE: Size = { width: 1280, height: 800 };
+
+const pagePolicies = new Map<string, string[]>();
+const sizes = new Map<string, Size>();
+const guarded = new WeakSet<BrowserContext>();
+
+/** The size a Bot's browser opens at and its live screen is cast at. */
+export function sizeFor(botId: string): Size {
+  return sizes.get(botId) ?? DEFAULT_SIZE;
+}
+
+/** A window size, kept to what Chrome draws well and a viewer can use. */
+export function clampSize(width: unknown, height: unknown): Size | null {
+  const w = Number(width), h = Number(height);
+  if (!Number.isFinite(w) || !Number.isFinite(h)) return null;
+  return { width: Math.round(Math.min(Math.max(w, 800), 1920)), height: Math.round(Math.min(Math.max(h, 500), 1200)) };
+}
+
+export function setSize(botId: string, size: Size): void {
+  if (size.width === DEFAULT_SIZE.width && size.height === DEFAULT_SIZE.height) sizes.delete(botId);
+  else sizes.set(botId, size);
+}
+
+/**
+ * An allowed address, as people write it: `dcc.godaddy.com/control/*\/dns`, `*.vercel.com`,
+ * `https://example.com/settings`. Scheme optional; `*` in the host is one label or more
+ * (`*.x.com` also matches `x.com`), `*` in the path anything. A path also allows what is below it;
+ * no path allows the whole site. The query and fragment are not checked.
+ */
+export function compilePattern(raw: string): { host: RegExp; path: RegExp } | null {
+  const v = raw.trim().replace(/^[a-z][a-z0-9+.-]*:\/\//i, "").replace(/[?#].*$/, "");
+  if (!v) return null;
+  const slash = v.indexOf("/");
+  const host = (slash === -1 ? v : v.slice(0, slash)).toLowerCase().replace(/:\d+$/, "");
+  const path = slash === -1 ? "" : v.slice(slash);
+  if (!/^[a-z0-9*.-]+$/.test(host)) return null;
+  const esc = (s: string) => s.replace(/[.+?^${}()|[\]\\]/g, "\\$&");
+  const hostRe = host.startsWith("*.")
+    ? new RegExp(`^(?:[a-z0-9-]+\\.)*${esc(host.slice(2)).replace(/\*/g, "[a-z0-9-]+")}$`)
+    : new RegExp(`^${esc(host).replace(/\*/g, "[a-z0-9-]+(?:\\.[a-z0-9-]+)*")}$`);
+  const trimmed = path.replace(/\/\*?$/, "");
+  const pathRe = trimmed ? new RegExp(`^${esc(trimmed).replace(/\*/g, ".*")}(?:/.*)?$`) : /^.*$/;
+  return { host: hostRe, path: pathRe };
+}
+
+/** Whether a page may open: what browsers make themselves (blank, errors) always may. */
+export function pageAllowed(patterns: string[], url: string): boolean {
+  if (/^(about|data|blob|chrome-error|chrome):/i.test(url)) return true;
+  let u: URL;
+  try { u = new URL(url); } catch { return false; }
+  if (u.protocol !== "http:" && u.protocol !== "https:") return false;
+  return patterns.some((p) => {
+    const c = compilePattern(p);
+    return Boolean(c && c.host.test(u.hostname.toLowerCase()) && c.path.test(u.pathname || "/"));
+  });
+}
+
+const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
+
+/** What a blocked page shows instead: what was asked for, and links to what is allowed. */
+export function blockedPage(url: string, patterns: string[]): string {
+  const links = patterns.map((p) => {
+    const plain = p.trim().replace(/^[a-z][a-z0-9+.-]*:\/\//i, "");
+    const openable = !plain.includes("*");
+    const href = `https://${plain}`;
+    return `<li>${openable ? `<a href="${escapeHtml(href)}">${escapeHtml(plain)}</a>` : `<code>${escapeHtml(plain)}</code>`}</li>`;
+  }).join("");
+  return `<!doctype html><meta charset="utf-8"><title>Not part of this shared access</title>
+<style>body{font:16px/1.5 system-ui,sans-serif;max-width:640px;margin:12vh auto;padding:0 24px;color:#1f2328}h1{font-size:22px}code,a{word-break:break-all}.u{color:#6e7781;font-size:14px;word-break:break-all}</style>
+<h1>This page isn't part of this shared access</h1>
+<p class="u">${escapeHtml(url.slice(0, 300))}</p>
+<p>You can open:</p><ul>${links}</ul>`;
+}
+
+/** The pages a Bot's browser may open; null: no limit. Applied at once if the browser is running. */
+export async function setPagePolicy(botId: string, patterns: string[] | null, context?: BrowserContext): Promise<void> {
+  if (patterns === null) pagePolicies.delete(botId);
+  else pagePolicies.set(botId, patterns.filter((p) => compilePattern(p)));
+  if (context) await guard(botId, context);
+}
+
+export function pagePolicy(botId: string): string[] | null {
+  return pagePolicies.get(botId) ?? null;
+}
+
+/**
+ * Checks every top-level navigation of a Bot that has a page policy. Installed once per browser and
+ * only when there is a policy, so other Bots' browsers carry no interception. Requests it does not
+ * decide on fall through to whatever else handles them.
+ */
+export async function guard(botId: string, context: BrowserContext): Promise<void> {
+  if (guarded.has(context) || !pagePolicies.has(botId)) return;
+  guarded.add(context);
+  await context.route("**/*", async (route: Route) => {
+    const request = route.request();
+    const patterns = pagePolicies.get(botId);
+    let topLevel = false;
+    try { topLevel = request.isNavigationRequest() && !request.frame().parentFrame(); } catch { topLevel = request.isNavigationRequest(); }
+    if (!patterns || !topLevel || pageAllowed(patterns, request.url())) return route.fallback();
+    return route.fulfill({ status: 403, contentType: "text/html; charset=utf-8", body: blockedPage(request.url(), patterns) });
+  });
+}
+
+/** The hosts a list of allowed addresses names, for copying sign-ins: `*.x.com/a` -> `x.com`. */
+export function hostsOf(patterns: string[]): string[] {
+  return [...new Set(patterns.map((p) => p.trim().replace(/^[a-z][a-z0-9+.-]*:\/\//i, "").split("/")[0].toLowerCase().replace(/:\d+$/, "").replace(/^\*\./, "")).filter((h) => h && !h.includes("*")))];
+}
+
+/** Whether a cookie belongs to one of these sites (the site itself or a subdomain, either way round). */
+export function cookieForHosts(cookieDomain: string, hosts: string[]): boolean {
+  const d = cookieDomain.replace(/^\./, "").toLowerCase();
+  // The registrable site, roughly: two labels, three under a country's second level (x.co.uk), so a
+  // copy for one site never takes a whole country's cookies.
+  const site = (h: string) => {
+    const l = h.split(".");
+    return l.slice(l.length > 2 && l.at(-1)!.length === 2 && l.at(-2)!.length <= 3 ? -3 : -2).join(".");
+  };
+  // The host, its subdomains, and anything within its site (godaddy.com for dcc.godaddy.com), never above it.
+  return hosts.some((h) => d === h || d.endsWith(`.${h}`) || d === site(h) || d.endsWith(`.${site(h)}`));
+}
+
+/** Copies one site's cookies from one browser into another; answers how many. */
+export async function importCookies(from: BrowserContext, to: BrowserContext, hosts: string[]): Promise<number> {
+  const picked = (await from.cookies()).filter((c) => cookieForHosts(c.domain, hosts));
+  if (picked.length) await to.addCookies(picked);
+  return picked.length;
+}
