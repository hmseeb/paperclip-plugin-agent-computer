@@ -0,0 +1,8 @@
+import { expect, test } from "bun:test";
+
+test("with EGRESS_BLOCK_PRIVATE=on the private network is denied like metadata addresses", async () => {
+  process.env.EGRESS_BLOCK_PRIVATE = "on";
+  const { isAlwaysDenied } = await import(`../src/egress.ts?private=${Date.now()}`);
+  for (const a of ["127.0.0.1", "10.1.2.3", "172.18.0.5", "192.168.1.1", "100.64.0.1", "::1", "fd12::1", "::ffff:10.0.0.1"]) expect(isAlwaysDenied(a)).toBe(true);
+  for (const a of ["93.184.215.14", "8.8.8.8", "2606:4700::1111"]) expect(isAlwaysDenied(a)).toBe(false);
+});
diff --git a/agent-computer/tests/runtime-upstream.test.ts b/agent-computer/tests/runtime-upstream.test.ts
new file mode 100644
index 0000000..8eb6b8f
--- /dev/null
+++ b/agent-computer/tests/runtime-upstream.test.ts
@@ -0,0 +1,12 @@
+import { expect, test } from "bun:test";
+import { setEgressUpstream, upstreamFor } from "../src/egress";
+
+test("a proxy pushed at runtime wins over the environment, and null means direct", () => {
+  const env = { EGRESS_PROXY_DEFAULT: "http://env-proxy:8080" };
+  expect(upstreamFor("bot-a", env)?.server).toBe("http://env-proxy:8080");
+  setEgressUpstream("bot-a", "http://user:p%40ss@res.example:7000");
+  expect(upstreamFor("bot-a", env)).toEqual({ server: "http://res.example:7000", username: "user", password: "p@ss" });
+  setEgressUpstream("bot-a", null);
+  expect(upstreamFor("bot-a", env)).toBeNull();
+  expect(upstreamFor("bot-b", env)?.server).toBe("http://env-proxy:8080");
+});
