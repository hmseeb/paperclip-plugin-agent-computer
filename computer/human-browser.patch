+/**
+ * Give one Bot's browser a filter port of its own, so the browser needs no proxy credentials.
+ *
+ * Chromium given a proxy username and password (Playwright answers the proxy's auth through the
+ * DevTools Fetch domain) stalls on some sites: Google search never finished loading, while the same
+ * proxy without credentials loads it in under a second. The port names the Bot instead. It listens on
+ * loopback inside the computer only, the same reach the shared port has.
+ */
+export async function egressPortFor(botId: string): Promise<number | null> {
+  const running = filter;
+  if (!running) return null;
+  const known = running.botPorts.get(botId);
+  if (known) return known.port;
+  const server = running.serve(botId);
+  await new Promise<void>((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(0, "127.0.0.1", () => resolve());
+  });
